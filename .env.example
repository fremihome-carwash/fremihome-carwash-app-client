# URL absoluta del backend (new-server). La lee client/lib/query-client.ts.
# Tiene precedencia sobre EXPO_PUBLIC_DOMAIN; sin ninguna de las dos el
# cliente cae a http://localhost:8080.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Alternativa host-only (dominios de tunel tipo Replit); se le antepone https://
# EXPO_PUBLIC_DOMAIN=

# La app se sirve desde <host>/carwash/, no desde la raiz. Expo Router lo usa
# como base de las rutas y del link a los assets. Mismo valor que EXPO_BASE_URL
# en .github/workflows/main.yml y que `apps` en cloudfront/viewer-request.js.
EXPO_BASE_URL=/carwash
